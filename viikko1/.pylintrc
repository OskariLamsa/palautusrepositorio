[MASTER]

ignore=tests

[MESSAGE CONTROL]

disable=raw-checker-failed,
        bad-inline-option,
        locally-disabled,
        file-ignored,
        suppressed-message,
        useless-suppression,
        deprecated-pragma,
        use-symbolic-message-instead,
        missing-module-docstring,
        missing-function-docstring,
        missing-class-docstring

[FORMAT]
[tool.pylint.format]
max-line-length = 80
#max-module-lines = 15

[REFACTORING]
[tool.pylint.refactoring]
max-nested-blocks = 2

[DESIGN]
[tool.pylint.design]
max-statements = 15